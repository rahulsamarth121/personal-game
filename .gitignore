# Secrets & local config
.env
.env.*
!.env.example

# Runtime data & logs (repo-root only; never ignore source trees)
/data/
/logs/
*.log

# Build artifacts
*.exe
*.msi
*.iso
*.zip
*.rar
*.7z
*.bin
/bin/
/dist/
*.agdai

# Compiled binaries placed at the repo root by local builds
/agent
/agent.exe
/controlplane
/controlplane.exe

# Game saves (runtime output, never source)
/saves/
*.sav

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python caches
__pycache__/
.ipynb_checkpoints/
.pytest_cache/

# Runner-local config
kaggle/runner/config/.env

# Node modules (none committed)
node_modules/

# Cloudflare Worker local state (account cache, deploy tmp) — never commit
deploy/cloudflare-worker/.wrangler/
*.wrangler/
