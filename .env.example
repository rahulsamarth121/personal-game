# Copy to .env and fill in. Scripts never overwrite an existing .env.
# Control plane
PG_LISTEN_ADDR=:8080
PG_DATABASE_URL=postgres://pg:pg@localhost:5432/personal_game?sslmode=disable
PG_MANIFEST_DIR=./games/manifests
PG_AUTH_ISSUER=personal-game
# Object storage: R2 live credentials, or R2_ENDPOINT for MinIO/S3-style.
# Nodes only ever receive short-lived presigned URLs, never these keys.
R2_ACCOUNT_ID=
R2_BUCKET=personal-game-saves
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# R2_ENDPOINT=http://127.0.0.1:9000
# Node agent
PG_CONTROL_URL=http://127.0.0.1:8080
PG_NODE_ID=
PG_DATA_DIR=./data
PG_GAMES_DIR=./data/games
PG_GAME_ROOT=
PG_CACHE_DIR=./data/cache
PG_STATE_DIR=./data/state
PG_TEMP_ROOT=./data/tmp
PG_GPU_INDEX=
PG_ENROLL_TOKEN=
PG_LEASE_TTL=30s
PG_HEARTBEAT_INTERVAL=10s

# --- Node agent (GPU node) ---
# STREAMING_ALLOWED=true only where the infrastructure provider permits
# interactive game streaming. The scheduler refuses nodes without it.
#MEDIA_NETWORK=tailscale
#MEDIA_NETWORK=cloudflare_private_network
#MEDIA_ENDPOINT=172.16.9.9
#STREAMING_ALLOWED=true

# --- Control plane ---
#PG_API_TOKEN=change-me-client-bearer-token

# --- Standard remote client URL (Windows Settings / Kaggle node) ---
# Control traffic goes through the Cloudflare edge relay (HTTP control only):
# https://personal-game-relay.rahul-zed-relay-84739261.workers.dev/personal-game
