# Builder for the control plane (no cgo: lib/pq is pure Go).
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -o /out/controlplane ./cmd/controlplane

FROM debian:bookworm-slim
RUN useradd -r -u 10001 personal-game
COPY --from=build /out/controlplane /usr/local/bin/controlplane
COPY games/manifests /seed/manifests
USER personal-game
EXPOSE 8080
ENTRYPOINT ["controlplane"]
