{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameManifest",
  "description": "Acquisition/install pipeline descriptor (schema_version 2). The manifest is data, never a shell script.",
  "type": "object",
  "required": ["schema_version", "game_id", "name", "version", "acquisition", "launch"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "game_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "acquisition": {
      "type": "object",
      "required": ["provider", "sources"],
      "properties": {
        "provider": {"type": "string", "enum": ["archive", "steamcmd", "legendary", "gog"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "part", "filename"],
            "properties": {
              "url": {"type": "string", "minLength": 1},
              "part": {"type": "integer", "minimum": 1},
              "filename": {"type": "string", "minLength": 1},
              "sha256": {"type": "string"},
              "size_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "footprint": {
      "type": "object",
      "properties": {
        "download_bytes": {"type": "integer", "minimum": 0},
        "peak_temp_bytes": {"type": "integer", "minimum": 0},
        "installed_bytes": {"type": "integer", "minimum": 0},
        "safety_headroom": {"type": "integer", "minimum": 0}
      }
    },
    "package_pipeline": {
      "type": "object",
      "properties": {
        "archive": {"type": "object", "properties": {"type": {"type": "string"}, "multipart": {"type": "boolean"}}},
        "result": {"type": "object", "properties": {"type": {"type": "string"}, "path": {"type": "string"}}},
        "iso": {"type": "object", "properties": {"extract": {"type": "boolean"}}},
        "installer": {
          "type": "object",
          "properties": {
            "type": {"type": "string"},
            "path": {"type": "string"},
            "arguments": {"type": "array", "items": {"type": "string"}},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "expected_dir": {"type": "string"}
          }
        }
      }
    },
    "runtime": {"type": "object", "properties": {"os": {"type": "string"}, "compatibility": {"type": "string"}}},
    "launch": {
      "type": "object",
      "required": ["executable"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string"}
      }
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "delete_parts_after_archive_extract": {"type": "boolean"},
        "delete_iso_after_extract": {"type": "boolean"},
        "delete_installer_after_install": {"type": "boolean"}
      }
    },
    "saves": {"type": "object", "properties": {"provider": {"type": "string"}}},
    "capabilities_required": {"type": "object"}
  }
}
